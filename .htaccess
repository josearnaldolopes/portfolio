# BEGIN josearnaldo.net
# Força HTTPS e www (só para josearnaldo.net: este public_html também serve outros domínios)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?josearnaldo\.net$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^josearnaldo\.net$ [NC]
RewriteRule ^(.*)$ https://www.josearnaldo.net/$1 [L,R=301]
</IfModule>

# Atalhos usados no site (www.josearnaldo.net/linkedin etc.)
Redirect 302 /linkedin https://www.linkedin.com/in/josearnaldolopes/
Redirect 302 /github https://github.com/josearnaldolopes
Redirect 302 /curriculo https://www.josearnaldo.net/curriculum/JoseArnaldo.pdf

# Não servir arquivos sensíveis (phpinfo.php fica liberado de propósito)
<FilesMatch "^(error_log|php\.ini|\.user\.ini|composer\.(txt|json|lock)|composer-installer\.sh|README\.md)$">
    Require all denied
</FilesMatch>
# END josearnaldo.net
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_flag allow_url_fopen On
   php_value max_execution_time 120
   php_value max_input_time 240
   php_value max_input_vars 10000
   php_value memory_limit 512M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php84"
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_flag allow_url_fopen On
   php_value max_execution_time 120
   php_value max_input_time 240
   php_value max_input_vars 10000
   php_value memory_limit 512M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php84"
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
